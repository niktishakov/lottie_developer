{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lottie-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE", "class_name": "DeviceSession" },
      { "name": "QUOTA", "class_name": "RegistrationQuota" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceSession"] },
    { "tag": "v2", "new_sqlite_classes": ["RegistrationQuota"] }
  ],
  // Лимиты на IP считает Cloudflare: не тратят запросы Durable Objects.
  "ratelimits": [
    { "name": "REGISTER_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
